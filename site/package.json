{
	"name": "localhelm-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"docs:build": "node scripts/build-docs.mjs",
		"dev": "pnpm docs:build && node ../scripts/ensure-lease.mjs localhelm-site 5206 && filepress dev --host 0.0.0.0",
		"build": "pnpm docs:build && filepress build",
		"preview": "filepress preview",
		"check": "filepress check",
		"ship": "pnpm build && wrangler pages deploy build --project-name=localhelm",
		"deploy": "pnpm ship"
	},
	"devDependencies": {
		"getfilepress": "^0.1.33",
		"wrangler": "^4.28.0"
	},
	"pnpm": {
		"overrides": {
			"cookie@<0.7.0": "0.7.2",
			"sharp": "0.35.4"
		},
		"onlyBuiltDependencies": [
			"esbuild",
			"getfilepress",
			"workerd"
		]
	}
}
