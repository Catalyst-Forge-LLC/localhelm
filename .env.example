# LocalHelm M1 needs no environment variables.
# Status talks to the public npm registry. Git uses the operator's existing remotes.
#
# Optional commit-draft pins (ollanet). Unset = discover a network/dedicated
# Ollama host first, this machine last, and use that host's first model tag.
# LOCALHELM_OLLAMA_MACHINE=studio
# LOCALHELM_OLLAMA_MODEL=llama3.2:3b
# LOCALHELM_OLLAMA_URL=http://192.168.1.10:11434
